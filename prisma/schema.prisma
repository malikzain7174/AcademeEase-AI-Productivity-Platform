model Account {
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([provider, providerAccountId])
    @@index([userId])
}

model Session {
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@id([identifier, token])
}

enum TagType {
    SYSTEM
    USER
}

model Tag {
    id     String  @id @default(cuid())
    name   String
    type   TagType
    taskId String
    Task   Task    @relation(fields: [taskId], references: [id])
}

model KanbanBoard {
    id          String         @id @default(cuid())
    name        String
    columns     KanbanColumn[]
    workspace   Workspace      @relation(fields: [workspaceId], references: [id])
    workspaceId String         @unique
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt

    @@index([workspaceId])
}

model KanbanColumn {
    id            String      @id @default(cuid())
    name          String
    order         Int
    color         String      @default("")
    tasks         Task[]
    kanbanBoard   KanbanBoard @relation(fields: [kanbanBoardId], references: [id])
    kanbanBoardId String
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    @@index([kanbanBoardId])
}

model Task {
    id               String            @id @default(cuid())
    title            String
    description      String?
    priority         Priority
    status           TaskStatus        @default(NOT_STARTED)
    deadline         DateTime
    workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
    workspaceId      String?
    userId           String? // Make userId optional for migration
    subtasks         Subtask[]
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    completedAt      DateTime? // Track when tasks are completed
    startedAt        DateTime? // Track when tasks are started
    estimatedHours   Float? // Estimated hours to complete
    actualHours      Float? // Actual hours spent
    KanbanColumn     KanbanColumn?     @relation(fields: [kanbanColumnId], references: [id], onDelete: Cascade)
    kanbanColumnId   String?
    tags             Tag[]
    activities       Activity[]
    notes            Note[]
    pomodoroSessions PomodoroSession[] // Relation to Pomodoro sessions

    @@index([workspaceId])
    @@index([deadline]) // Index for faster deadline-based queries
    @@index([userId]) // Index for faster user-based queries
}

model Activity {
    id        String   @id @default(cuid())
    title     String
    createdAt DateTime @default(now())
    task      Task?    @relation(fields: [taskId], references: [id])
    taskId    String?
}

model Subtask {
    id           String   @id @default(cuid())
    title        String
    description  String
    completed    Boolean
    Task         Task?    @relation(fields: [parentTaskId], references: [id])
    parentTaskId String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model Note {
    id          String     @id @default(cuid())
    title       String
    content     String
    task        Task?      @relation(fields: [taskId], references: [id])
    taskId      String?
    workspace   Workspace? @relation(fields: [workspaceId], references: [id])
    workspaceId String?
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@index([taskId])
    @@index([workspaceId])
}

model Workspace {
    id               String            @id @default(cuid())
    name             String
    description      String?
    color            String?
    user             User              @relation(fields: [userId], references: [id])
    userId           String
    KanbanBoard      KanbanBoard?
    notes            Note[]
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    Task             Task[]
    activities       UserActivity[]
    pomodoroSessions PomodoroSession[] // Relation to Pomodoro sessions

    @@index([userId])
}

enum GradeYear {
    FRESHMAN
    SOPHOMORE
    JUNIOR
    SENIOR
    GRADUATE
}

enum LearningStyle {
    VISUAL
    AUDITORY
    KINESTHETIC
}

enum StudyEnvironment {
    QUIET_ROOM
    LIBRARY
    OUTDOORS
}

enum AgeRange {
    UNDER_18
    AGE_18_21
    AGE_22_25
    AGE_26_30
    OVER_30
}

enum Priority {
    HIGHEST
    HIGH
    MEDIUM
    LOW
    LOWEST
}

enum TaskStatus {
    NOT_STARTED
    IN_PROGRESS
    COMPLETED
}

model UserActivity {
    id          String     @id @default(cuid())
    userId      String
    user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    type        String // e.g., "TASK_CREATED", "TASK_COMPLETED", "WORKSPACE_CREATED"
    description String? // Description of the activity
    entityId    String? // ID of the related entity (task, workspace, etc.)
    createdAt   DateTime   @default(now())
    workspaceId String?
    workspace   Workspace? @relation(fields: [workspaceId], references: [id])

    @@index([userId])
    @@index([createdAt])
    @@index([workspaceId])
}

model DashboardWidget {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      String // e.g., "upcoming_tasks", "completed_tasks", "productivity_chart"
    config    Json? // Widget-specific configuration
    position  Int // Position on dashboard
    size      String // e.g., "1x1", "2x1" for grid layout
    enabled   Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

enum PomodoroSessionType {
    FOCUS
    SHORT_BREAK
    LONG_BREAK
}

// Pomodoro Session model to store completed Pomodoro sessions
model PomodoroSession {
    id          String              @id @default(cuid())
    goal        String // The goal or task name for this session
    duration    Int // Duration in seconds
    completedAt DateTime // When the session was completed
    sessionType PomodoroSessionType @default(FOCUS) // Type of session (focus or break)
    userId      String // Foreign key to User
    user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Optional workspace relation if the session is associated with a workspace
    workspaceId String?
    workspace   Workspace? @relation(fields: [workspaceId], references: [id])

    // Optional task relation if the session is associated with a specific task
    taskId String?
    task   Task?   @relation(fields: [taskId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([completedAt]) // For efficient date-based queries
    @@index([workspaceId])
    @@index([taskId])
    @@index([sessionType]) // For efficient filtering by session type
}
