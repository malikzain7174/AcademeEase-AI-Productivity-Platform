datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id                 String            @id @default(cuid())
    name               String?
    email              String            @unique
    image              String?
    age                Int?
    credits            Int               @default(0)
    emailVerified      DateTime?
    password           String? // Hashed password for email/password auth
    verificationCode   String? // For email verification
    verificationExpiry DateTime? // When the verification code expires
    isVerified         Boolean           @default(false) // Track if user is verified
    gradeYear          GradeYear?
    fieldOfStudy       String?
    learningStyle      LearningStyle?
    studyEnvironment   StudyEnvironment?
    ageRange           AgeRange?
    // academicGoals       AcademicGoal[]       @relation
    // interests           Interest[]           @relation
    // background          BackgroundKnowledge? @relation(fields: [backgroundKnowledgeId], references: [id])
    // challenges          Challenge[]          @relation
    // specialRequirements SpecialRequirement[] @relation
    // persona             Persona[]            @relation
    accounts           Account[]
    sessions           Session[]
    workspace          Workspace[]
    lastActive         DateTime?
    loginCount         Int               @default(0)
    preferences        Json? // Store user dashboard preferences
    activities         UserActivity[]
    dashboardWidgets   DashboardWidget[]
    pomodoroSessions   PomodoroSession[] // Relation to Pomodoro sessions

    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
    subscriptionId String?

    @@index([email])
}

model Subscription {
    id           String @id @default(cuid())
    name         String
    dailyCredits Int
    users        User[]
}

